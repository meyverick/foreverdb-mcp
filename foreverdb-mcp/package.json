{
  "name": "foreverdb-mcp",
  "version": "0.2.0",
  "description": "ForeverDB MCP server: World of Warcraft Forever game data for AI assistants",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "wow",
    "world-of-warcraft",
    "foreverdb"
  ],
  "license": "MIT",
  "author": "meyverick",
  "homepage": "https://github.com/meyverick/foreverdb-mcp#readme",
  "repository": "github:meyverick/foreverdb-mcp",
  "bugs": "https://github.com/meyverick/foreverdb-mcp/issues",
  "type": "module",
  "bin": {
    "foreverdb": "src/main.ts"
  },
  "files": [
    "src"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "bun src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build": "bun build src/main.ts --target=bun --outdir=dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/bun": "^1.3.2",
    "typescript": "^5.9.3"
  }
}
